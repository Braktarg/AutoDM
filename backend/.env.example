SECRET_KEY=cambia-esto-en-produccion
DATABASE_URL=sqlite+aiosqlite:///./data/autodm.db

# Por defecto: Ollama local (chat + embeddings RAG)
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_LLM_MODEL=gemma4:e4b
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_TEMPERATURE=0.85
# Segundos máx. esperando la respuesta del chat (modelos grandes / VRAM compartida).
OLLAMA_CHAT_TIMEOUT_SECONDS=600
# Velocidad del turno (opcional): menos tokens generados = suele responder antes.
# OLLAMA_NUM_PREDICT=512
# Ventana de contexto del modelo (solo si quieres limitar VRAM/tiempo por paso de atención).
# OLLAMA_NUM_CTX=4096

# Perfil de ritmo Sprint 1: fast | balanced | cinematic | custom
# custom = sólo usar las variables DM_* / OLLAMA_NUM_PREDICT siguientes sin aplicar presets.
# fast activa pipeline sin LLM por turno + menos RAG.
DM_PACE=fast

# Pipeline por turno: fast (sin LLM, ~ms) | hybrid (LLM solo si hace falta) | full (2 LLM siempre)
DM_ACTION_PIPELINE=hybrid
# Embeddings RAG en cada acción (lento). Dejar false en mesa activa.
DM_PLAY_RAG_ON_TURN=false
# Resumen de sesión / eventos / grafo tras enviar la respuesta (no bloquea el chat).
DM_PLAY_DEFER_HEAVY_WORK=true
# Tokens máx. por llamada LLM del pipeline (parse/efectos)
DM_PIPELINE_LLM_NUM_PREDICT=320
DM_PIPELINE_LLM_TEMPERATURE=0.15
DM_PIPELINE_LLM_NUM_CTX=2048

# Flujo de rol más ágil: prompt más corto + DM pide respuestas contenidas.
DM_BRIEF_REPLIES=false
# DM_RAG_RULES_K=4
# DM_RAG_SHEETS_K=2
# DM_RECENT_CHAT_MESSAGES=12
# DM_GRAPH_CONTEXT_LIMIT=12

# --- Sprint 2 · calidad narrativa ---
# Regenerar resumen de sesión cada N respuestas del DM (0 = desactivado).
DM_SESSION_SUMMARY_EVERY_N=8
DM_CONSISTENCY_GUARD=true
DM_SCENE_ADAPTATION=true

# Si LLM_PROVIDER=openai (embeddings y chat en la nube)
OPENAI_API_KEY=
OPENAI_BASE_URL=
LLM_MODEL=gpt-4o-mini

# GraphRAG Neo4j (opcional). Sin esto, cada mesa usa grafo JSON local en data/graphs/.
USE_NEO4J=false
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=autodm-secret-change-me

CHUNK_SIZE=1200
CHUNK_OVERLAP=200

# --- Sprint 3 · RAG (re-ranking híbrido + prioridad por tipo de fuente) ---
RAG_RERANK_ENABLED=true
# Candidatos Chroma antes del re-rank = DM_RAG_RULES_K (o SHEETS_K) × este factor (máx. 40).
DM_RAG_FETCH_MULTIPLIER=3
# Peso lexical (resto va al score vectorial a partir de la distancia de Chroma).
RAG_LEXICAL_WEIGHT=0.38
RAG_TIER_BOOST_OFFICIAL=1.14
RAG_TIER_BOOST_DM_NOTES=1.07
RAG_TIER_BOOST_HOMEBREW=1.0
RAG_TIER_BOOST_MANUAL=1.03
RAG_TIER_BOOST_CHARACTER=1.04

# --- Sprint 4 · chat casi en tiempo real (SSE) ---
# El frontend abre GET /api/campaigns/<id>/messages/events?token=<JWT> (EventSource).
# Tras cada turno guardado se notifica a los clientes conectados; no requiere variables nuevas.

# --- Grafo estilo Obsidian (wikilinks / hashtags en el chat) ---
# Jugador y DM: [[Nombre]] y #Nombre crean/actualizan nodos Entity y aristas CO_OCCURS entre co-apariciones.
GRAPH_MENTIONS_ENABLED=true
GRAPH_MENTION_WIKILINK=true
GRAPH_MENTION_HASHTAG=true
GRAPH_MENTION_LABEL=Entity
GRAPH_MENTION_MIN_LEN=2
GRAPH_MENTION_MAX_LEN=80
GRAPH_MENTION_COOCCURRENCE=true

# --- Sprint 5 · mundo persistente y eventos ---
# Redis opcional para pub/sub SSE entre múltiples procesos.
REDIS_URL=
# Scheduler de mundo persistente (segundos). 0 = desactivado.
WORLD_TICK_INTERVAL_SECONDS=0
